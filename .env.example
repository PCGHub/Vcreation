# Fill in only the providers needed for your workflow.
REPLICATE_API_TOKEN=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Paid video is disabled by default. Never put this token in frontend environment files.
VCREATION_ENABLE_PAID_GENERATION=false
# Pinned 64-character version hash from your chosen Replicate model's API page.
VCREATION_REPLICATE_VERSION=
# Your documented estimate in USD per requested output second, not a provider quote.
VCREATION_VIDEO_USD_PER_SECOND=
# Match these fields to the selected model's actual input schema.
VCREATION_DURATION_FIELD=duration
VCREATION_IMAGE_FIELD=image
VCREATION_IMAGE_MODE=single
VCREATION_VIDEO_EXTRA_INPUT={}
# Optional SQLite database path. Back up it and static/studio/ together.
VCREATION_DATABASE=
