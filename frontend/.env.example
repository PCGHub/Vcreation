# Same-origin Next.js proxy; this is read on the server, never sent as a credential.
BACKEND_URL=http://127.0.0.1:8000
# Optional direct browser API base. Leave empty when using the proxy.
NEXT_PUBLIC_API_BASE_URL=
# Optional existing account dashboard. The local /studio does not require Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
